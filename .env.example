# ---------------------------------------------------------------- database
# SQLite: um arquivo só. Caminhos relativos são resolvidos a partir de prisma/.
# Em produção a instância usa file:/data/app.db (volume persistente).
DATABASE_URL="file:./dev.db"

# Banco separado usado por `npm test` (opcional, mas recomendado):
# DATABASE_URL_TEST="file:./test.db"

# ------------------------------------------------------------------- auth
# 32+ random chars. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-with-openssl-rand-base64-48"
# Session lifetime in days (default 7).
SESSION_TTL_DAYS="7"

# ------------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --------------------------------------------------------- image storage
# STORAGE_DRIVER=local keeps uploads in ./public/uploads (development only).
# STORAGE_DRIVER=s3 stores them in an S3-compatible bucket (AWS S3, R2, MinIO).
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Custom endpoint for S3-compatible providers (MinIO, Cloudflare R2). Optional on AWS.
S3_ENDPOINT=""
# Public base URL where bucket objects are served (CDN or bucket URL).
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"

# ------------------------------------------------- first admin (seed only)
# Used by `npm run db:seed` / `npm run admin:create` to create the first user.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Artur Hamann Ronconi"
