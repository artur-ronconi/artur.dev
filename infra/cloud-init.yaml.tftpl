#cloud-config
# Primeiro boot da instância (Amazon Linux 2023, ARM64). Gerado pelo Terraform.

# Sem package_update: a AMI já vem atualizada e processar o repositório inteiro estoura a RAM.
packages:
  - docker
  - sqlite
  - jq

write_files:
  - path: /etc/artur-dev/config.env
    permissions: "0644"
    content: |
      AWS_REGION="${region}"
      PROJECT="${project}"
      SECRET_ID="${secret_id}"
      SITE_ADDRESS="${site_address}"
      ACME_EMAIL="${acme_email}"
      BACKUP_BUCKET="${backup_bucket}"

  - path: /usr/local/bin/artur-deploy
    permissions: "0755"
    encoding: b64
    content: ${deploy_script_b64}

  - path: /usr/local/bin/artur-backup
    permissions: "0755"
    encoding: b64
    content: ${backup_script_b64}

  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" }
      }

  - path: /etc/systemd/system/artur-backup.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Backup diario do SQLite para o S3

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/artur-backup

  - path: /etc/systemd/system/artur-backup.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Agenda o backup diario do SQLite

      [Timer]
      OnCalendar=*-*-* 05:00:00 UTC
      Persistent=true
      RandomizedDelaySec=15min

      [Install]
      WantedBy=timers.target

# O swap precisa existir ANTES de instalar pacotes: com ~412 MB de RAM úteis o dnf é morto por
# falta de memória (OOM). bootcmd roda no início do boot, antes dos módulos de pacotes.
bootcmd:
  - |
    if ! swapon --show | grep -q /swapfile; then
      [ -f /swapfile ] || dd if=/dev/zero of=/swapfile bs=1M count=${swap_size_mb}
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
      echo 'vm.swappiness=10' > /etc/sysctl.d/99-swap.conf
      sysctl -p /etc/sysctl.d/99-swap.conf
    fi

runcmd:
  - mkdir -p /data /opt/artur-dev
  - chown 1001:1001 /data
  - systemctl enable --now docker
  - systemctl daemon-reload
  - systemctl enable --now artur-backup.timer
  # A aplicação sobe no primeiro deploy (workflow Deploy), quando a imagem chega pelo S3.
